import("//BnesBrowser/components/ai_chat/core/common/buildflags/buildflags.gni")
import("//BnesBrowser/components/brave_vpn/common/buildflags/buildflags.gni")
import("//BnesBrowser/components/brave_wallet/common/buildflags/buildflags.gni")
import("//BnesBrowser/components/containers/buildflags/buildflags.gni")
import("//BnesBrowser/components/tor/buildflags/buildflags.gni")

brave_chromium_src_chrome_test_test_support_sources = [
  "//BnesBrowser/test/base/testing_brave_browser_process.cc",
  "//BnesBrowser/test/base/testing_brave_browser_process.h",
]

brave_chromium_src_chrome_test_test_support_deps = [
  "//BnesBrowser/components/brave_ads/buildflags",
  "//BnesBrowser/components/brave_origin",
  "//BnesBrowser/components/brave_shields/content/browser",
  "//BnesBrowser/components/brave_shields/core/browser",
  "//BnesBrowser/components/brave_shields/core/browser:test_support",
  "//BnesBrowser/components/brave_vpn/common/buildflags",
  "//BnesBrowser/components/brave_wallet/common/buildflags",
  "//BnesBrowser/components/tor/buildflags",
]

if (enable_ai_chat) {
  brave_chromium_src_chrome_test_test_support_deps +=
      [ "//BnesBrowser/components/ai_chat/core/browser:test_support" ]
}

if (enable_brave_vpn_v1) {
  brave_chromium_src_chrome_test_test_support_deps +=
      [ "//BnesBrowser/components/brave_vpn/browser/connection:api" ]
}

if (enable_tor) {
  brave_chromium_src_chrome_test_test_support_deps += [ "//BnesBrowser/browser/tor" ]
}

if (enable_brave_wallet) {
  brave_chromium_src_chrome_test_test_support_deps +=
      [ "//BnesBrowser/browser/brave_wallet" ]
}

brave_chromium_src_chrome_test_unit_tests_deps = []
if (enable_containers && (is_win || is_mac)) {
  brave_chromium_src_chrome_test_unit_tests_deps += [
    "//BnesBrowser/components/containers/buildflags",
    "//BnesBrowser/components/containers/content/browser",
    "//BnesBrowser/components/containers/core/common:features",
  ]
}
