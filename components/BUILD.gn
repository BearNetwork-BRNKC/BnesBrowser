import("//BnesBrowser/components/ai_chat/core/common/buildflags/buildflags.gni")
import("//BnesBrowser/components/brave_vpn/common/buildflags/buildflags.gni")
import("//BnesBrowser/components/brave_wallet/common/buildflags/buildflags.gni")
import("//BnesBrowser/components/brave_wayback_machine/buildflags/buildflags.gni")
import("//BnesBrowser/components/containers/buildflags/buildflags.gni")
import("//BnesBrowser/components/email_aliases/buildflags/buildflags.gni")
import("//BnesBrowser/components/local_ai/buildflags/buildflags.gni")
import("//BnesBrowser/components/playlist/core/common/buildflags/buildflags.gni")
import("//BnesBrowser/components/psst/buildflags/buildflags.gni")
import("//BnesBrowser/components/speedreader/common/buildflags/buildflags.gni")
import("//BnesBrowser/components/traffic_control/buildflags/buildflags.gni")
import("//build/config/features.gni")
import("//build/config/ui.gni")
import("//extensions/buildflags/buildflags.gni")
import("//testing/test.gni")
import("//tools/grit/repack.gni")

if (is_ios) {
  import("//ios/build/config.gni")
}

test("brave_components_unittests") {
  use_xvfb = use_xvfb_in_this_config

  deps = [
    "//base",
    "//BnesBrowser/components/ai_chat/core/common/buildflags",
    "//BnesBrowser/components/api_request_helper:unit_tests",
    "//BnesBrowser/components/assist_ranker:unit_tests",
    "//BnesBrowser/components/brave_account:unit_tests",
    "//BnesBrowser/components/brave_account/endpoint_client:unit_tests",
    "//BnesBrowser/components/brave_account/endpoints:unit_tests",
    "//BnesBrowser/components/brave_origin:unit_tests",
    "//BnesBrowser/components/brave_policy:unit_tests",
    "//BnesBrowser/components/brave_policy/ad_block_only_mode:unit_tests",
    "//BnesBrowser/components/brave_private_cdn:unit_tests",
    "//BnesBrowser/components/brave_shields/core/browser:unit_tests",
    "//BnesBrowser/components/brave_shields/core/common:unit_tests",
    "//BnesBrowser/components/brave_sync:unit_tests",
    "//BnesBrowser/components/component_updater:unit_tests",
    "//BnesBrowser/components/https_upgrade_exceptions/browser:unit_tests",
    "//BnesBrowser/components/image_metadata_stripper/internal:unit_tests",
    "//BnesBrowser/components/json:unit_tests",
    "//BnesBrowser/components/oblivious_http:unit_tests",
    "//BnesBrowser/components/screenshot/core/browser:unit_tests",
    "//BnesBrowser/components/static_redirect_helper:unit_tests",
    "//BnesBrowser/components/time_period_storage:unit_tests",
    "//BnesBrowser/components/update_client:unit_tests",
    "//BnesBrowser/components/url_sanitizer/core/browser:unit_tests",
    "//components/test:run_all_unittests",
  ]

  if (enable_brave_wallet) {
    deps += [
      "//BnesBrowser/components/brave_wallet/browser:unit_tests",
      "//BnesBrowser/components/brave_wallet/common:unit_tests",
    ]
  }

  if (enable_containers) {
    deps += [
      "//BnesBrowser/components/containers/content/browser:unit_tests",
      "//BnesBrowser/components/containers/core/browser:unit_tests",
    ]
  }

  if (enable_extensions) {
    deps +=
        [ "//BnesBrowser/components/extension_malware_blocklist/browser:unit_tests" ]
  }

  if (enable_traffic_control) {
    deps += [ "//BnesBrowser/components/traffic_control/core/browser:unit_tests" ]
  }

  if (enable_psst) {
    deps += [ "//BnesBrowser/components/psst/core/browser:unit_tests" ]
  }

  if (enable_brave_wayback_machine) {
    deps += [ "//BnesBrowser/components/brave_wayback_machine:unit_tests" ]
  }

  if (enable_speedreader) {
    deps += [ "//BnesBrowser/components/speedreader:unit_tests" ]
  }

  if (enable_ai_chat) {
    deps += [
      "//BnesBrowser/components/ai_chat/core/browser:unit_tests",
      "//BnesBrowser/components/ai_chat/core/browser/ollama:unit_tests",
      "//BnesBrowser/components/ai_chat/core/common:unit_tests",
      "//BnesBrowser/components/web_mcp/core/browser:unit_tests",
    ]
  }

  if (enable_brave_vpn_v2) {
    deps += [
      "//BnesBrowser/components/brave_vpn/browser/v2/api:unit_tests",
      "//BnesBrowser/components/brave_vpn/common/v2:unit_tests",
    ]
  }

  if (enable_brave_vpn_v2_apps) {
    deps += [
      "//BnesBrowser/components/brave_vpn/app/v2/agent:unit_tests",
      "//BnesBrowser/components/brave_vpn/app/v2/shared:unit_tests",
    ]
  }

  if (enable_email_aliases) {
    deps += [ "//BnesBrowser/components/email_aliases:unit_tests" ]
  }

  if (enable_local_ai) {
    deps += [ "//BnesBrowser/components/local_ai/core:unit_tests" ]
  }

  if (enable_playlist) {
    deps += [ "//BnesBrowser/components/playlist/core/browser:unit_tests" ]
  }

  if (use_blink) {
    if (enable_local_ai) {
      deps += [ "//BnesBrowser/components/local_ai/content:unit_tests" ]
    }
    if (enable_ai_chat) {
      deps += [ "//BnesBrowser/components/ai_chat/content/browser:unit_tests" ]
    }
    if (enable_brave_wallet) {
      deps += [
        "//BnesBrowser/components/brave_wallet/browser:unit_tests",
        "//BnesBrowser/components/brave_wallet/renderer/test:unit_tests",
      ]
    }
  }

  if (is_ios) {
    bundle_deps = [
      ":components_tests_pak_bundle_data",
      "//components:components_tests_pak_bundle_data",
    ]
  } else {
    data_deps = [
      ":components_tests_pak",
      "//components:components_tests_pak",
      "//third_party/angle:includes",
      "//ui/resources:ui_test_pak_data",
    ]
  }

  if (is_android) {
    deps += [
      "//content/public/android:content_java",
      "//content/public/browser",
      "//gin:v8_snapshot_assets",
      "//net",
      "//ui/android:ui_java",
      "//ui/base",
      "//ui/gfx",
    ]
  }

  # No components should depend on Chrome.
  # Since //chrome depends on //extensions, we also only assert_no_deps on
  # extensions targets.
  assert_no_deps = [
    "//BnesBrowser/browser/*",
    "//BnesBrowser/common/*",
    "//BnesBrowser/renderer/*",
    "//BnesBrowser/updater/*",
    "//BnesBrowser/utility/*",
    "//chrome/*",
  ]
  assert_no_deps += [
    "//extensions/browser/*",
    "//extensions/common:core_api_provider",
    "//extensions/components/*",

    # //extensions/renderer/resources:extensions_renderer_generated_resources is
    # a dependency of //extensions/common:common, and components do make use of
    # things like URLPattern from it. Asserting on the local renderer is enough
    # though to prevent renderer code.
    "//extensions/renderer:*",
  ]

  if (is_ios) {
    assert_no_deps += ios_assert_no_deps
    assert_no_deps += [ "//ios/chrome/*" ]
    assert_no_deps += [ "//BnesBrowser/ios/*" ]
    assert_no_deps += [
      "//extensions/common",
      "//extensions/common:mojom",
      "//extensions/common/api/*",
    ]
  }
}

if (is_ios) {
  bundle_data("components_tests_pak_bundle_data") {
    testonly = true
    public_deps = [ ":components_tests_pak" ]
    sources = [
      "$root_gen_dir/components/brave_components_strings_en-US.pak",
      "$root_out_dir/brave_components_tests_resources.pak",
    ]
    outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
  }
}

repack("components_tests_pak") {
  sources = [
    "$root_gen_dir/components/brave_components_resources.pak",
    "$root_gen_dir/components/brave_components_strings_en-US.pak",
  ]

  output = "$root_out_dir/brave_components_tests_resources.pak"
  public_deps = [
    "//BnesBrowser/components/resources",
    "//BnesBrowser/components/resources:strings",
  ]
}
