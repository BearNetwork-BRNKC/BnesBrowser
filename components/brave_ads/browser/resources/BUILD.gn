import("//BnesBrowser/components/brave_ads/buildflags/buildflags.gni")
import("//BnesBrowser/components/common/typescript.gni")

assert(enable_brave_ads)

transpile_web_ui("ads_internals_ui") {
  entry_points = [ [
        "ads_internals",
        rebase_path("ads_internals.tsx"),
      ] ]

  public_deps = [
    "//BnesBrowser/components/services/bat_ads/public/interfaces",
    "//mojo/public/mojom/base",
  ]

  resource_name = "ads_internals"
  imports_from = [ "//BnesBrowser/components/brave_ads/browser/resources/" ]
}

pack_web_resources("generated_resources") {
  resource_name = "ads_internals"
  output_dir = "$root_gen_dir/BnesBrowser/components/brave_ads/browser/resources"
  deps = [ ":ads_internals_ui" ]
}
