import("//BnesBrowser/components/brave_rewards/core/buildflags/buildflags.gni")

source_set("brave_adaptive_captcha") {
  sources = [
    "brave_adaptive_captcha_delegate.h",
    "brave_adaptive_captcha_service.cc",
    "brave_adaptive_captcha_service.h",
    "get_adaptive_captcha_challenge.cc",
    "get_adaptive_captcha_challenge.h",
    "pref_names.h",
    "prefs_util.cc",
    "prefs_util.h",
    "server_util.cc",
    "server_util.h",
  ]

  if (is_android) {
    sources += [
      "android/attest_android.cc",
      "android/attest_android.h",
    ]
  }

  deps = [
    "//base",
    "//BnesBrowser/components/api_request_helper",
    "//BnesBrowser/components/brave_rewards/core",
    "//BnesBrowser/components/brave_rewards/core/buildflags",
    "//BnesBrowser/components/brave_rewards/core/buildflags:endpoint_buildflags",
    "//components/keyed_service/core",
    "//components/prefs",
    "//net",
    "//services/network/public/cpp",
  ]

  if (enable_brave_rewards) {
    deps += [ "//BnesBrowser/components/brave_rewards/content" ]
  }
}
