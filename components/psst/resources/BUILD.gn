import("//BnesBrowser/components/common/typescript.gni")
import("//BnesBrowser/components/psst/buildflags/buildflags.gni")
import("//BnesBrowser/resources/brave_grit.gni")
import("//mojo/public/tools/bindings/mojom.gni")
import("//tools/grit/repack.gni")

transpile_web_ui("dialog") {
  entry_points = [ [
        "brave_psst_dialog",
        rebase_path("ui/brave_psst_dialog.tsx"),
      ] ]

  deps = [
    "//BnesBrowser/components/psst/core/common:mojom_js",
    "//BnesBrowser/components/resources:strings",
  ]

  resource_name = "brave_psst_dialog"

  imports_from = [ "//BnesBrowser/components/psst/resources/ui/" ]
}

pack_web_resources("psst_dialog_generated_resources") {
  resource_name = "brave_psst_dialog"
  output_dir = "$root_gen_dir/BnesBrowser/components/psst/resources"

  deps = [ ":dialog" ]
}

brave_grit("static_resources") {
  source = "brave_psst_static_resources.grd"

  outputs = [
    "grit/brave_psst_resources.h",
    "brave_psst_static.pak",
  ]
}

repack("resources") {
  public_deps = [
    ":psst_dialog_generated_resources",
    ":static_resources",
  ]

  sources = [
    "$root_gen_dir/BnesBrowser/components/psst/resources/brave_psst_dialog_generated.pak",
    "$root_gen_dir/BnesBrowser/components/psst/resources/brave_psst_static.pak",
  ]

  output =
      "$root_gen_dir/BnesBrowser/components/psst/resources/brave_psst_resources.pak"
}
