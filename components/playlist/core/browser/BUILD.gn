import("//BnesBrowser/components/playlist/core/common/buildflags/buildflags.gni")

static_library("browser") {
  sources = [
    "playlist_exclusions.cc",
    "playlist_exclusions.h",
    "playlist_exclusions_component_installer.cc",
    "playlist_exclusions_component_installer.h",
    "utils.cc",
    "utils.h",
  ]

  deps = [
    "//base",
    "//BnesBrowser/components/brave_component_updater/browser:public",
    "//BnesBrowser/components/playlist/core/common",
    "//BnesBrowser/components/playlist/core/common/buildflags",
    "//components/component_updater",
    "//components/prefs",
    "//net",
    "//url",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "playlist_exclusion_unittest.cc",
    "utils_unittest.cc",
  ]

  deps = [
    "//base",
    "//base/test:test_support",
    "//BnesBrowser/components/playlist/core/browser",
    "//BnesBrowser/components/playlist/core/common",
    "//components/prefs",
    "//components/prefs:test_support",
    "//testing/gtest",
    "//url",
  ]
}
