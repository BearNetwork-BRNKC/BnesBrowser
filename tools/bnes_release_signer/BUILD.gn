# Offline release signing tool for the BNES update pipeline (plan section 68).
# Runs on the release machine only; the seed (private key) never ships.
executable("bnes_release_signer") {
  sources = [ "bnes_release_signer.cc" ]
  deps = [ "//third_party/boringssl" ]
}