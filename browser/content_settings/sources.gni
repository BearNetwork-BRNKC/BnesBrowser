import("//BnesBrowser/components/containers/buildflags/buildflags.gni")

brave_browser_content_settings_deps = [
  "//BnesBrowser/components/brave_shields/content/browser",
  "//BnesBrowser/components/brave_user_agent/browser",
  "//BnesBrowser/components/containers/buildflags",
  "//components/user_prefs",
]

if (enable_containers) {
  brave_browser_content_settings_deps += [
    "//BnesBrowser/components/containers/content/browser",
    "//BnesBrowser/components/containers/core/common",
  ]
}

# In upstream Chromium, extensions/common/url_pattern_set.h
# belongs to //extensions/common which is a real target.
# But on Android where enable_extensions=false, that target
# doesn't exist/isn't built. So effectively, on Android, the
# header has no upstream owner - and Brave's source_set
# //BnesBrowser/extensions:common "claims" to make it available.
#
# So //chrome/browser/content_settings:unit_tests needs
# //BnesBrowser/extensions:common to satisfy gn_check
brave_browser_content_settings_unit_tests_deps = [ "//BnesBrowser/extensions:common" ]
