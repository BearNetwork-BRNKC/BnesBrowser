import("//BnesBrowser/components/ai_chat/core/common/buildflags/buildflags.gni")
import("//BnesBrowser/components/common/typescript.gni")

assert(!is_android)

transpile_web_ui("resources") {
  entry_points = [ [
        "brave_new_tab_page",
        rebase_path("brave_new_tab_page.tsx"),
      ] ]
  resource_name = "brave_new_tab_page_refresh"
  imports_from = [
    "//BnesBrowser/browser/resources/brave_new_tab_page_refresh/",
    "//BnesBrowser/components/ai_chat/resources/",
    "//BnesBrowser/components/brave_news/browser/resources/",
    "//BnesBrowser/components/brave_rewards/resources/",
  ]
  deps = [
    "//BnesBrowser/browser/ui/webui/brave_new_tab_page_refresh:mojom_js",

    # Unconditional for gn check as typescript cannnot yet conditionally import
    # during typecheck.
    # TODO(https://github.com/brave/brave-browser/issues/53190): remove when
    # fixed.
    "//BnesBrowser/components/ai_chat/core/common/mojom:mojom_js",
    "//BnesBrowser/components/brave_ads/core/mojom:mojom_js",
    "//BnesBrowser/components/brave_news/common:mojom_js",
    "//BnesBrowser/components/brave_rewards/core/mojom:webui_js",
    "//BnesBrowser/components/brave_vpn/common/mojom:mojom_js",
    "//BnesBrowser/components/ntp_background_images/browser/mojom:mojom_js",
    "//BnesBrowser/components/resources:strings",
    "//components/omnibox/browser:mojo_bindings_js",
  ]
}

pack_web_resources("generated_resources") {
  resource_name = "brave_new_tab_page_refresh"
  output_dir =
      "$root_gen_dir/BnesBrowser/browser/resources/brave_new_tab_page_refresh"
  deps = [ ":resources" ]
}
