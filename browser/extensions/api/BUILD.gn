import("//BnesBrowser/common/extensions/api/api_sources.gni")
import("//BnesBrowser/components/brave_talk/buildflags/buildflags.gni")
import("//BnesBrowser/components/web_discovery/buildflags/buildflags.gni")
import("//tools/json_schema_compiler/json_schema_api.gni")

function_registration("generated_api_registration") {
  sources = brave_extensions_api_schema_sources
  impl_dir = "//BnesBrowser/browser/extensions/api/"
  bundle_name = "Brave"
  root_namespace = brave_extensions_api_root_namespace

  custom_impl_schemas = [ "brave_theme" ]
  inputs = [ "//BnesBrowser/browser/extensions/api/brave_theme_api.h" ]

  if (enable_web_discovery) {
    custom_impl_schemas += [ "web_discovery" ]
    inputs += [ "//BnesBrowser/browser/extensions/api/web_discovery_api.h" ]
  }

  if (enable_brave_talk) {
    custom_impl_schemas += [ "brave_talk" ]
    inputs += [ "//BnesBrowser/browser/extensions/api/brave_talk_api.h" ]
  }

  deps = [
    "//extensions/browser",
    "//extensions/common",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [ "brave_theme_api_unittest.cc" ]

  deps = [
    "//BnesBrowser/browser/extensions",
    "//chrome/browser/themes",
    "//chrome/test:test_support",
    "//testing/gtest",
  ]
}
