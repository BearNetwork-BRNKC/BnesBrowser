import("//BnesBrowser/components/ai_chat/core/common/buildflags/buildflags.gni")
import("//BnesBrowser/components/brave_news/common/buildflags/buildflags.gni")
import("//BnesBrowser/components/containers/buildflags/buildflags.gni")
import("//extensions/buildflags/buildflags.gni")

brave_browser_browsing_data_sources = [
  "//BnesBrowser/browser/browsing_data/brave_browsing_data_remover_delegate.cc",
  "//BnesBrowser/browser/browsing_data/brave_browsing_data_remover_delegate.h",
  "//BnesBrowser/browser/browsing_data/brave_clear_browsing_data.cc",
  "//BnesBrowser/browser/browsing_data/brave_clear_browsing_data.h",
]

brave_browser_browsing_data_deps = [
  "//base",
  "//BnesBrowser/components/ai_chat/core/common/buildflags",
  "//BnesBrowser/components/brave_news/common/buildflags",
  "//BnesBrowser/components/containers/buildflags",
  "//BnesBrowser/components/content_settings/core/common",
  "//chrome/browser:browser_process",
  "//chrome/browser/browsing_data:constants",
  "//chrome/browser/profiles:profile",
  "//chrome/common",
  "//components/browsing_data/core",
  "//components/content_settings/core/browser",
  "//components/content_settings/core/common",
  "//components/prefs",
  "//content/public/browser",
]

if (enable_ai_chat) {
  brave_browser_browsing_data_deps += [
    "//BnesBrowser/browser/ai_chat",
    "//BnesBrowser/components/ai_chat/core/browser",
  ]
}

if (enable_brave_news) {
  brave_browser_browsing_data_deps +=
      [ "//BnesBrowser/components/brave_news/browser" ]
}

if (enable_extensions) {
  brave_browser_browsing_data_deps += [
    "//BnesBrowser/common/extensions/api",
    "//extensions/browser",
  ]
}

if (enable_containers) {
  brave_browser_browsing_data_deps += [
    "//BnesBrowser/browser/containers",
    "//BnesBrowser/components/containers/content/browser",
    "//BnesBrowser/components/containers/core/browser",
    "//BnesBrowser/components/containers/core/common",
  ]
}
