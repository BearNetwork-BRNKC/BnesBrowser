import("//BnesBrowser/components/ai_chat/core/common/buildflags/buildflags.gni")
import("//BnesBrowser/components/brave_news/common/buildflags/buildflags.gni")
import("//BnesBrowser/components/brave_rewards/core/buildflags/buildflags.gni")
import("//BnesBrowser/components/brave_talk/buildflags/buildflags.gni")
import("//BnesBrowser/components/brave_vpn/common/buildflags/buildflags.gni")
import("//BnesBrowser/components/brave_wallet/common/buildflags/buildflags.gni")
import("//BnesBrowser/components/brave_wayback_machine/buildflags/buildflags.gni")
import("//BnesBrowser/components/email_aliases/buildflags/buildflags.gni")
import("//BnesBrowser/components/ipfs/buildflags/buildflags.gni")
import("//BnesBrowser/components/local_ai/buildflags/buildflags.gni")
import("//BnesBrowser/components/playlist/core/common/buildflags/buildflags.gni")
import("//BnesBrowser/components/psst/buildflags/buildflags.gni")
import("//BnesBrowser/components/speedreader/common/buildflags/buildflags.gni")
import("//BnesBrowser/components/tor/buildflags/buildflags.gni")
import("//build/config/features.gni")

source_set("brave_origin") {
  sources = [
    "brave_origin_navigation.h",
    "brave_origin_service_factory.cc",
    "brave_origin_service_factory.h",
  ]

  public_deps = [ "//BnesBrowser/components/brave_origin" ]

  deps = [
    "//base",
    "//BnesBrowser/browser/policy:brave_simple_policy_map",
    "//BnesBrowser/browser/skus",
    "//BnesBrowser/components/ai_chat/core/common/buildflags",
    "//BnesBrowser/components/brave_news/common/buildflags",
    "//BnesBrowser/components/brave_policy",
    "//BnesBrowser/components/brave_rewards/core",
    "//BnesBrowser/components/brave_rewards/core/buildflags",
    "//BnesBrowser/components/brave_talk/buildflags",
    "//BnesBrowser/components/brave_vpn/common/buildflags",
    "//BnesBrowser/components/brave_wallet/common/buildflags",
    "//BnesBrowser/components/brave_wayback_machine/buildflags",
    "//BnesBrowser/components/constants",
    "//BnesBrowser/components/email_aliases/buildflags",
    "//BnesBrowser/components/ipfs/buildflags",
    "//BnesBrowser/components/local_ai/buildflags",
    "//BnesBrowser/components/p3a",
    "//BnesBrowser/components/playlist/core/common/buildflags",
    "//BnesBrowser/components/psst/buildflags",
    "//BnesBrowser/components/speedreader/common/buildflags",
    "//BnesBrowser/components/tor/buildflags",
    "//chrome/browser:browser_process",
    "//chrome/browser/profiles",
    "//components/keyed_service/content",
    "//components/policy/core/browser",
    "//components/policy/core/common",
  ]

  if (is_android) {
    sources += [ "android/brave_origin_service_factory_android.cc" ]
    deps += [ "//BnesBrowser/browser/brave_origin/android:jni_headers" ]
  }

  if (enable_ai_chat) {
    deps += [ "//BnesBrowser/components/ai_chat/core/common" ]
  }

  if (enable_brave_news) {
    deps += [ "//BnesBrowser/components/brave_news/common" ]
  }

  if (enable_brave_vpn) {
    deps += [ "//BnesBrowser/components/brave_vpn/common" ]
  }

  if (enable_local_ai) {
    deps += [ "//BnesBrowser/components/local_ai/core" ]
  }

  if (enable_brave_wayback_machine) {
    deps += [ "//BnesBrowser/components/brave_wayback_machine" ]
  }

  if (enable_speedreader) {
    deps += [ "//BnesBrowser/components/speedreader" ]
  }

  if (enable_playlist) {
    deps += [ "//BnesBrowser/components/playlist/core/common" ]
  }

  if (enable_tor) {
    deps += [ "//BnesBrowser/components/tor:pref_names" ]
  }

  if (deprecate_ipfs) {
    deps += [ "//BnesBrowser/components/ipfs" ]
  }

  if (enable_brave_wallet) {
    deps += [ "//BnesBrowser/components/brave_wallet/browser:pref_names" ]
  }

  if (enable_brave_talk) {
    deps += [ "//BnesBrowser/components/brave_talk" ]
  }

  if (enable_email_aliases) {
    deps += [
      "//BnesBrowser/components/email_aliases:pref_names",
      "//BnesBrowser/components/email_aliases:service",
    ]
  }

  if (enable_psst) {
    deps += [ "//BnesBrowser/components/psst/core/browser" ]
  }
}

source_set("unit_tests") {
  testonly = true

  sources = [ "brave_origin_service_factory_unittest.cc" ]

  deps = [
    ":brave_origin",
    "//base/test:test_support",
    "//BnesBrowser/browser/policy:brave_simple_policy_map",
    "//BnesBrowser/browser/ui/brave_origin",
    "//BnesBrowser/components/brave_origin",
    "//BnesBrowser/components/brave_rewards/core",
    "//BnesBrowser/components/brave_rewards/core/buildflags",
    "//BnesBrowser/components/constants",
    "//BnesBrowser/components/p3a",
    "//chrome/browser/profiles",
    "//chrome/test:test_support",
    "//components/policy:generated",
    "//components/policy/core/common:test_support",
    "//content/test:test_support",
    "//testing/gtest",
  ]

  if (enable_tor) {
    deps += [ "//BnesBrowser/components/tor:pref_names" ]
  }
}
