# Phase A updater (BNES_BROWSER_ARCHITECTURE_EVOLUTION_PLAN.md section 68.3):
# update notification only. Never downloads or executes installers.
source_set("bnes_update") {
  sources = [
    "bnes_update_checker.cc",
    "bnes_update_checker.h",
  ]

  deps = [
    "//base",
    "//BnesBrowser/components/version_info",
    "//chrome/browser/upgrade_detector:impl",
    "//chrome/browser/upgrade_detector:upgrade_detector",
    "//services/network/public/cpp",
    "//url",
  ]
}