import("//BnesBrowser/components/brave_rewards/core/buildflags/buildflags.gni")

source_set("impl") {
  visibility = [ "//BnesBrowser/browser:core" ]

  sources = [ "brave_adaptive_captcha_service_factory.cc" ]

  deps = [
    ":brave_adaptive_captcha",
    "//base",
    "//BnesBrowser/components/brave_adaptive_captcha",
    "//BnesBrowser/components/brave_rewards/core/buildflags",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui",
    "//components/keyed_service/content",
    "//components/user_prefs",
  ]

  if (enable_brave_rewards) {
    deps += [ "//BnesBrowser/browser/brave_rewards" ]
  }

  if (!is_android) {
    deps += [ "//chrome/browser/ui/browser_window" ]
  }
}

source_set("brave_adaptive_captcha") {
  sources = [ "brave_adaptive_captcha_service_factory.h" ]

  public_deps = [
    "//components/keyed_service/content",
    "//content/public/browser",
  ]
}
