import("//BnesBrowser/components/email_aliases/buildflags/buildflags.gni")
import("//build/config/ui.gni")

assert(enable_email_aliases)

static_library("email_aliases") {
  sources = [
    "email_aliases_service_factory.cc",
    "email_aliases_service_factory.h",
  ]

  deps = [
    "//base",
    "//BnesBrowser/browser/brave_account",
    "//BnesBrowser/components/brave_account",
    "//BnesBrowser/components/email_aliases:features",
    "//BnesBrowser/components/email_aliases:service",
    "//chrome/browser:browser_process",
    "//chrome/browser/profiles:profile",
    "//components/keyed_service/content",
    "//components/pref_registry",
    "//components/prefs",
    "//components/user_prefs",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
  ]

  public_deps = [ "//BnesBrowser/components/email_aliases:mojom" ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "email_aliases_service_factory_unittest.cc" ]
  deps = [
    ":email_aliases",
    "//base",
    "//BnesBrowser/browser/brave_account",
    "//BnesBrowser/components/brave_account",
    "//BnesBrowser/components/brave_account:features",
    "//BnesBrowser/components/email_aliases:features",
    "//BnesBrowser/components/email_aliases:pref_names",
    "//BnesBrowser/components/email_aliases:service",
    "//chrome/browser/profiles",
    "//chrome/test:test_support",
    "//components/keyed_service/core",
    "//components/os_crypt/async/browser:test_support",
    "//mojo/public/cpp/bindings",
    "//testing/gtest",
    "//ui/base",
  ]
}

if (toolkit_views) {
  source_set("browser_tests") {
    testonly = true

    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

    sources = [
      "email_aliases_autofill_browsertest.cc",
      "email_aliases_browsertest.cc",
    ]

    deps = [
      ":email_aliases",
      "//BnesBrowser/browser/brave_account",
      "//BnesBrowser/browser/ui/email_aliases",
      "//BnesBrowser/components/brave_account",
      "//BnesBrowser/components/brave_account:features",
      "//BnesBrowser/components/brave_account:test_support",
      "//BnesBrowser/components/brave_account/endpoint_client:test_support",
      "//BnesBrowser/components/brave_account/endpoints",
      "//BnesBrowser/components/brave_account/mojom",
      "//BnesBrowser/components/email_aliases:email_aliases_api_types",
      "//BnesBrowser/components/email_aliases:features",
      "//BnesBrowser/components/email_aliases:pref_names",
      "//BnesBrowser/components/email_aliases:service",
      "//BnesBrowser/components/email_aliases:test_utils",
      "//BnesBrowser/components/resources:strings_grit",
      "//chrome/browser",
      "//chrome/browser/autofill",
      "//chrome/browser/policy:test_support",
      "//chrome/browser/ui/autofill",
      "//chrome/browser/ui/views/bubble",
      "//chrome/test:test_support",
      "//components/keyed_service/core",
      "//components/os_crypt/async/browser:test_support",
      "//services/network:test_support",
    ]

    data = [ "//BnesBrowser/test/data/email_aliases" ]
  }
}
