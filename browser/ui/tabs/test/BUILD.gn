source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  sources = [
    "brave_tab_strip_model_browsertest.cc",
    "tree_tabs_browsertest.cc",
  ]

  deps = [
    "//BnesBrowser/components/constants",
    "//BnesBrowser/components/tabs",
    "//chrome/app:command_ids",
    "//chrome/browser",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/tab_group_sync:factories",
    "//chrome/browser/ui",
    "//chrome/browser/ui/navigator",
    "//components/prefs",
    "//content/test:test_support",
    "//ui/base",
  ]

  if (!is_android) {
    sources += [
      "shared_pinned_tab_service_browsertest.cc",
      "shared_pinned_tab_service_browsertest.h",
      "tab_data_browsertest.cc",
    ]
    deps += [
      "//BnesBrowser/browser/ui/tabs:tab_strip",
      "//BnesBrowser/components/resources:scaled_resources",
      "//chrome/browser/ui:ui_features",
      "//chrome/browser/ui/browser_window",
      "//chrome/browser/ui/tabs",
      "//chrome/browser/ui/toasts",
      "//chrome/common",
      "//chrome/test:test_support",
      "//chrome/test:test_support_ui",
      "//components/tab_groups",
      "//ui/base",
      "//url",
    ]
  }

  if (is_mac) {
    sources += [ "shared_pinned_tab_service_browsertest_mac.mm" ]
  }
}

source_set("unit_tests") {
  testonly = true

  sources = []
  deps = []

  if (!is_android) {
    sources += [
      "tab_style_unittest.cc",
      "tree_tab_node_tab_collection_unittest.cc",
      "vertical_tab_controller_unittest.cc",
    ]
    deps += [
      "//BnesBrowser/browser/ui/focus_mode",
      "//BnesBrowser/browser/ui/tabs:tabs_public",
      "//BnesBrowser/components/tabs",
      "//chrome/browser/ui/tabs:test_support",
      "//chrome/test:test_support",
      "//components/tabs:test_support",
      "//content/test:test_support",
      "//testing/gmock",
      "//testing/gtest",
    ]
  }
}
