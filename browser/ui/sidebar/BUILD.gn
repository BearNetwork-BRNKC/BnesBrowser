  testonly = true

  sources = [
    "sidebar_browsertest_base.cc",
    "sidebar_browsertest_base.h",
  ]

  public_deps = [
    ":sidebar",
    ":sidebar_impl",
    "//base",
    "//BnesBrowser/browser/ui/views/frame",
    "//BnesBrowser/browser/ui/views/frame/split_view",
