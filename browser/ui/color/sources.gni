import("//BnesBrowser/components/playlist/core/common/buildflags/buildflags.gni")
import("//build/config/ui.gni")

brave_browser_ui_color_mixers_sources = []
brave_browser_ui_color_mixers_deps = []

if (!is_android) {
  brave_browser_ui_color_mixers_sources += [
    "//BnesBrowser/browser/ui/color/brave_color_id.h",
    "//BnesBrowser/browser/ui/color/brave_color_mixer.cc",
    "//BnesBrowser/browser/ui/color/brave_color_mixer.h",
    "//BnesBrowser/browser/ui/color/brave_material_side_panel_color_mixer.cc",
    "//BnesBrowser/browser/ui/color/brave_material_side_panel_color_mixer.h",
    "//BnesBrowser/browser/ui/color/color_palette.h",
    "//BnesBrowser/browser/ui/color/material_brave_color_mixer.cc",
    "//BnesBrowser/browser/ui/color/material_brave_color_mixer.h",
  ]

  brave_browser_ui_color_mixers_deps += [
    "//BnesBrowser/components/brave_vpn/common/buildflags",
    "//BnesBrowser/components/brave_wayback_machine/buildflags",
    "//BnesBrowser/components/playlist/core/common/buildflags",
    "//BnesBrowser/components/speedreader/common/buildflags",
    "//BnesBrowser/ui/color:brave_color_mixers",
    "//skia",
    "//ui/color",
    "//ui/gfx",
    "//ui/native_theme",
  ]

  if (enable_playlist) {
    brave_browser_ui_color_mixers_sources += [
      "//BnesBrowser/browser/ui/color/playlist/playlist_color_mixer.cc",
      "//BnesBrowser/browser/ui/color/playlist/playlist_color_mixer.h",
    ]
    brave_browser_ui_color_mixers_deps +=
        [ "//BnesBrowser/components/playlist/core/common" ]
  }
}

if (toolkit_views) {
  brave_browser_ui_color_mixers_deps += [ "//BnesBrowser/browser/ui/darker_theme" ]
}
