import("//BnesBrowser/components/brave_rewards/core/buildflags/buildflags.gni")

source_set("ads_internals") {
  sources = [
    "ads_internals_ui.cc",
    "ads_internals_ui.h",
  ]

  deps = [
    "//BnesBrowser/browser/brave_ads",
    "//BnesBrowser/components/brave_ads/browser",
    "//BnesBrowser/components/brave_ads/browser/resources:generated_resources",
    "//BnesBrowser/components/brave_ads/core",
    "//BnesBrowser/components/brave_rewards/core",
    "//chrome/browser:browser_public_dependencies",
    "//chrome/browser/profiles:profile",
  ]

  if (enable_brave_rewards) {
    sources += [
      "ads_internals_logs_handler.cc",
      "ads_internals_logs_handler.h",
    ]

    deps += [
      "//BnesBrowser/browser/brave_rewards",
      "//BnesBrowser/components/brave_rewards/content",
      "//BnesBrowser/components/brave_rewards/core:features",
      "//chrome/browser:flags",
      "//chrome/browser/lifetime",
      "//components/webui/flags",
    ]
  }

  public_deps = [
    "//base",
    "//BnesBrowser/components/brave_ads/core/public:headers",
    "//BnesBrowser/components/brave_rewards/core/buildflags",
    "//BnesBrowser/components/services/bat_ads/public/interfaces",
    "//components/prefs",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
  ]
}

if (enable_brave_rewards) {
  source_set("unit_tests") {
    testonly = true

    sources = [ "ads_internals_logs_handler_unittest.cc" ]

    deps = [
      ":ads_internals",
      "//base/test:test_support",
      "//BnesBrowser/components/brave_ads/browser:test_support",
      "//BnesBrowser/components/brave_rewards/core:features",
      "//BnesBrowser/components/brave_rewards/core/buildflags",
      "//BnesBrowser/components/services/bat_ads/public/interfaces",
      "//components/prefs:test_support",
      "//components/webui/flags",
      "//mojo/public/cpp/bindings",
      "//testing/gmock",
      "//testing/gtest",
    ]
  }
}
