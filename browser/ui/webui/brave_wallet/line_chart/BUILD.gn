import("//BnesBrowser/components/brave_wallet/common/buildflags/buildflags.gni")

assert(enable_brave_wallet)

source_set("line_chart") {
  sources = [
    "line_chart_ui.cc",
    "line_chart_ui.h",
  ]
  deps = [
    "//BnesBrowser/browser/ui/webui/brave_wallet/market",
    "//BnesBrowser/components/brave_wallet/browser:constants",
    "//BnesBrowser/components/brave_wallet/common:common_constants",
    "//BnesBrowser/components/brave_wallet_ui:resources",
    "//BnesBrowser/components/brave_wallet_ui/line_chart:line_chart_display_generated",
    "//BnesBrowser/components/resources:static_resources_grit",
    "//chrome/browser/profiles",
    "//content/public/browser",
    "//ui/webui",
  ]

  if (!is_android) {
    deps += [ "//chrome/browser/ui/webui:theme_source" ]
  }
}
