import("//BnesBrowser/components/brave_education/buildflags.gni")
import("//BnesBrowser/components/brave_news/common/buildflags/buildflags.gni")
import("//BnesBrowser/components/brave_origin/buildflags/buildflags.gni")
import("//BnesBrowser/components/brave_vpn/common/buildflags/buildflags.gni")
import("//BnesBrowser/components/containers/buildflags/buildflags.gni")
import("//BnesBrowser/components/playlist/core/common/buildflags/buildflags.gni")
import("//BnesBrowser/components/psst/buildflags/buildflags.gni")
import("//BnesBrowser/components/traffic_control/buildflags/buildflags.gni")

# This is required for chromium_src overrides.
brave_browser_ui_webui_configs_deps = [
  "//base",
  "//BnesBrowser/browser/ui",
  "//BnesBrowser/components/brave_account:features",
  "//BnesBrowser/components/brave_education:buildflags",
  "//BnesBrowser/components/brave_news/common/buildflags",
  "//BnesBrowser/components/brave_origin/buildflags",
  "//BnesBrowser/components/brave_shields/content/browser",
  "//BnesBrowser/components/brave_vpn/common/buildflags",
  "//BnesBrowser/components/containers/buildflags",
  "//BnesBrowser/components/playlist/core/common/buildflags",
]

if (enable_playlist_webui) {
  brave_browser_ui_webui_configs_deps += [
    "//BnesBrowser/components/playlist/core/browser",
    "//BnesBrowser/components/playlist/core/common",
  ]
}

if (enable_brave_vpn) {
  brave_browser_ui_webui_configs_deps +=
      [ "//BnesBrowser/components/brave_vpn/browser" ]
}

if (enable_brave_education) {
  brave_browser_ui_webui_configs_deps +=
      [ "//BnesBrowser/browser/ui/webui/brave_education" ]
}

if (enable_brave_news && !is_android) {
  brave_browser_ui_webui_configs_deps +=
      [ "//BnesBrowser/browser/ui/webui/brave_news" ]
}

if (is_brave_origin_branded) {
  brave_browser_ui_webui_configs_deps +=
      [ "//BnesBrowser/browser/ui/webui/brave_origin_startup" ]
}

if (enable_containers) {
  brave_browser_ui_webui_configs_deps += [
    "//BnesBrowser/components/containers/core/browser",
    "//BnesBrowser/components/containers/core/common",
    "//BnesBrowser/components/containers/core/mojom",
  ]
}

if (enable_traffic_control) {
  brave_browser_ui_webui_configs_deps += [
    "//BnesBrowser/browser/traffic_control",
    "//BnesBrowser/components/traffic_control/core/browser",
    "//BnesBrowser/components/traffic_control/core/common",
    "//BnesBrowser/components/traffic_control/core/mojom",
  ]
}

if (enable_psst) {
  brave_browser_ui_webui_configs_deps += [ "//BnesBrowser/browser/ui/webui/psst" ]
}
