import("//BnesBrowser/components/ai_chat/core/common/buildflags/buildflags.gni")
import("//BnesBrowser/components/brave_ads/buildflags/buildflags.gni")
import("//BnesBrowser/components/brave_news/common/buildflags/buildflags.gni")
import("//BnesBrowser/components/brave_rewards/core/buildflags/buildflags.gni")
import("//BnesBrowser/components/brave_talk/buildflags/buildflags.gni")
import("//BnesBrowser/components/brave_vpn/common/buildflags/buildflags.gni")
import("//BnesBrowser/components/ntp_background_images/buildflags/buildflags.gni")
import("//mojo/public/tools/bindings/mojom.gni")

assert(!is_android)
assert(enable_custom_background)

mojom("mojom") {
  sources = [ "brave_new_tab_page.mojom" ]
  deps = [
    "//BnesBrowser/components/brave_ads/core/mojom",
    "//BnesBrowser/components/brave_vpn/common/mojom",
  ]
  enabled_features = []
  if (enable_brave_talk) {
    enabled_features += [ "enable_brave_talk" ]
  }
}

source_set("brave_new_tab_page_refresh") {
  sources = [
    "background_facade.cc",
    "background_facade.h",
    "brave_new_tab_page_ui.cc",
    "brave_new_tab_page_ui.h",
    "custom_image_chooser.cc",
    "custom_image_chooser.h",
    "new_tab_page_handler.cc",
    "new_tab_page_handler.h",
    "new_tab_page_initializer.cc",
    "new_tab_page_initializer.h",
    "sponsored_sites_facade.cc",
    "sponsored_sites_facade.h",
    "top_sites_facade.cc",
    "top_sites_facade.h",
    "update_observer.cc",
    "update_observer.h",
    "vpn_facade.cc",
    "vpn_facade.h",
  ]

  deps = [
    ":mojom",
    "//BnesBrowser/browser:browser_process",
    "//BnesBrowser/browser/brave_stats:first_run_util",
    "//BnesBrowser/browser/misc_metrics",
    "//BnesBrowser/browser/ntp_background",
    "//BnesBrowser/browser/resources/brave_new_tab_page_refresh:generated_resources",
    "//BnesBrowser/components/ai_chat/core/common/buildflags",
    "//BnesBrowser/components/brave_ads/buildflags",
    "//BnesBrowser/components/brave_rewards/core/buildflags",
    "//chrome/browser/new_tab_page",
    "//chrome/browser/ui/webui:plural_string_handler",

    # Unconditional for gn check as the NTP WebUI always needs the mojom
    # types since typescript cannnot yet conditionally import during typecheck.
    # TODO(https://github.com/brave/brave-browser/issues/53190): remove when
    # fixed.
    "//BnesBrowser/components/ai_chat/core/common/mojom",

    # Unconditional for gn check since the mojom-forward header is included
    # in brave_new_tab_page_ui.h (guarded by ENABLE_BRAVE_NEWS buildflag).
    "//BnesBrowser/components/brave_news/common:mojom",
    "//BnesBrowser/components/brave_news/common/buildflags",
    "//BnesBrowser/components/brave_perf_predictor/common",
    "//BnesBrowser/components/brave_rewards/core",
    "//BnesBrowser/components/brave_rewards/core/mojom:webui",
    "//BnesBrowser/components/brave_search_conversion",
    "//BnesBrowser/components/brave_talk/buildflags",
    "//BnesBrowser/components/brave_vpn/common/buildflags",
    "//BnesBrowser/components/constants",
    "//BnesBrowser/components/misc_metrics",
    "//BnesBrowser/components/ntp_background_images/browser",
    "//BnesBrowser/components/ntp_background_images/common",
    "//BnesBrowser/components/resources:static_resources",
    "//BnesBrowser/components/resources:strings",
    "//chrome/app:generated_resources",
    "//chrome/browser:browser_process",
    "//chrome/browser:browser_public_dependencies",
    "//chrome/browser/autocomplete",
    "//chrome/browser/bookmarks",
    "//chrome/browser/contextual_search",
    "//chrome/browser/history",
    "//chrome/browser/ntp_tiles",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/search_engines",
    "//chrome/browser/themes",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/select_file_policy",
    "//chrome/browser/ui/webui:favicon_source",
    "//chrome/browser/ui/webui:theme_source",
    "//chrome/browser/ui/webui:webui_util",
    "//chrome/browser/ui/webui/searchbox",
    "//components/contextual_search:public",
    "//components/omnibox/browser",
    "//components/prefs",
    "//components/regional_capabilities",
    "//components/strings:components_strings",
    "//content/public/browser",
    "//third_party/metrics_proto",
    "//ui/base",
    "//ui/shell_dialogs",
    "//ui/webui",
  ]

  if (enable_brave_rewards) {
    deps += [
      "//BnesBrowser/browser/brave_rewards",
      "//BnesBrowser/browser/brave_rewards:util",
    ]
  }

  if (enable_ai_chat) {
    deps += [
      "//BnesBrowser/browser/ai_chat",
      "//BnesBrowser/browser/ui/webui/ai_chat",
      "//BnesBrowser/components/ai_chat/core/browser",
      "//BnesBrowser/components/ai_chat/core/common",
    ]
  }

  if (enable_brave_ads) {
    deps += [ "//BnesBrowser/browser/brave_ads" ]
  }

  if (enable_brave_vpn) {
    deps += [
      "//BnesBrowser/browser/ui/brave_vpn",
      "//BnesBrowser/components/brave_vpn/browser",
      "//BnesBrowser/components/brave_vpn/common",
    ]
  }

  if (enable_brave_talk) {
    deps += [ "//BnesBrowser/components/brave_talk" ]
  }

  if (enable_brave_news) {
    deps += [
      "//BnesBrowser/browser/brave_news",
      "//BnesBrowser/components/brave_news/browser",
    ]
  }
}

source_set("browser_tests") {
  testonly = true

  sources = [
    "brave_new_tab_page_ui_browsertest.cc",
    "ntp_feature_disabled_browsertest.cc",
  ]

  deps = [
    ":brave_new_tab_page_refresh",
    "//base",
    "//BnesBrowser/browser/extensions:test_support",
    "//BnesBrowser/components/ai_chat/core/common/buildflags",
    "//BnesBrowser/components/brave_ads/buildflags",
    "//BnesBrowser/components/brave_news/common/buildflags",
    "//BnesBrowser/components/brave_rewards/core/buildflags",
    "//BnesBrowser/components/brave_vpn/common/buildflags",
    "//chrome/browser/ui",
    "//chrome/common",
    "//chrome/test:test_support",
    "//components/policy/core/browser",
    "//components/policy/core/common:test_support",
    "//content/public/browser",
    "//content/public/common:result_codes",
    "//content/test:test_support",
    "//testing/gtest",
    "//url",
  ]

  if (enable_ai_chat) {
    sources += [ "ntp_ai_chat_browsertest.cc" ]

    deps += [
      "//BnesBrowser/components/ai_chat/core/common",
      "//BnesBrowser/components/brave_search_conversion",
      "//chrome/browser/profiles:profile",
      "//components/prefs",
    ]
  }

  if (enable_brave_ads) {
    sources += [ "new_tab_takeover_browsertest.cc" ]

    deps += [
      "//BnesBrowser/browser/brave_ads",
      "//BnesBrowser/components/brave_ads/core",
      "//BnesBrowser/components/brave_ads/core/browser/service:test_support",
      "//BnesBrowser/components/ntp_background_images/browser",
      "//BnesBrowser/components/ntp_background_images/browser:test_support",
      "//chrome/browser/profiles/keep_alive",
      "//chrome/browser/sessions",
      "//components/keyed_service/content",
      "//components/keyed_service/core",
    ]
  }

  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
}

source_set("unit_tests") {
  testonly = true

  sources = []

  if (enable_brave_ads) {
    sources += [ "sponsored_sites_facade_unittest.cc" ]
  }

  deps = [
    ":brave_new_tab_page_refresh",
    ":mojom",
    "//base",
    "//base/test:test_support",
    "//BnesBrowser/components/brave_ads/buildflags",
    "//BnesBrowser/components/brave_rewards/core",
    "//BnesBrowser/components/brave_rewards/core/buildflags",
    "//BnesBrowser/components/constants",
    "//BnesBrowser/components/ntp_background_images/browser",
    "//BnesBrowser/components/ntp_background_images/browser:test_support",
    "//BnesBrowser/components/ntp_background_images/common",
    "//components/history/core/browser",
    "//components/history/core/test",
    "//components/prefs",
    "//components/prefs:test_support",
    "//components/sync_preferences:test_support",
    "//testing/gtest",
    "//url",
  ]

  if (enable_brave_ads) {
    deps += [ "//BnesBrowser/components/brave_ads/core" ]
  }
}
