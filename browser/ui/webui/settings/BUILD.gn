import("//BnesBrowser/components/brave_ads/buildflags/buildflags.gni")
import("//BnesBrowser/components/brave_wallet/common/buildflags/buildflags.gni")
import("//BnesBrowser/components/email_aliases/buildflags/buildflags.gni")

source_set("unit_tests") {
  if (!is_android) {
    testonly = true

    sources = [
      "brave_importer_observer_unittest.cc",
      "brave_search_engines_handler_unittest.cc",
      "brave_site_settings_handler_unittest.cc",
      "brave_sync_handler_unittest.cc",
    ]

    deps = [
      "//base/test:test_support",
      "//BnesBrowser/components/brave_shields/core/common",
      "//BnesBrowser/components/resources:strings_grit",
      "//chrome/browser",
      "//chrome/browser/regional_capabilities",
      "//chrome/browser/search_engines",
      "//chrome/browser/ui",
      "//chrome/browser/ui/navigator",
      "//chrome/browser/ui/webui/settings",
      "//chrome/test:test_support",
      "//components/browsing_data/content:test_support",
      "//components/regional_capabilities",
      "//components/search_engines",
      "//components/sync_preferences:test_support",
      "//content/test:test_support",
      "//testing/gtest",
      "//ui/base/clipboard",
      "//ui/base/clipboard:clipboard_test_support",
    ]

    if (enable_brave_ads) {
      sources += [ "brave_clear_browsing_data_handler_unittest.cc" ]

      deps += [
        "//BnesBrowser/browser/brave_ads",
        "//BnesBrowser/components/brave_ads/core/browser/service:test_support",
        "//testing/gmock",
      ]
    }

    if (enable_brave_wallet) {
      sources += [ "brave_wallet_handler_unittest.cc" ]

      deps += [
        "//BnesBrowser/browser/brave_wallet",
        "//BnesBrowser/components/brave_wallet/browser",
        "//BnesBrowser/components/brave_wallet/browser:constants",
        "//BnesBrowser/components/brave_wallet/browser:pref_names",
        "//BnesBrowser/components/brave_wallet/browser:test_support",
        "//BnesBrowser/components/brave_wallet/browser:utils",
        "//BnesBrowser/components/brave_wallet/common:test_support",
        "//components/user_prefs",
      ]
    }
  }
}

source_set("browser_tests") {
  if (!is_android) {
    testonly = true

    sources = [
      "brave_manage_profile_browsertest.cc",
      "settings_secure_dns_handler_browsertest.cc",
    ]

    deps = [
      "//chrome/browser/ui/",
      "//chrome/browser/ui/webui/settings",
      "//chrome/test:test_support",
      "//chrome/test:test_support_ui",
    ]

    if (enable_email_aliases) {
      sources += [ "email_aliases_link_browsertest.cc" ]
      deps += [
        "//BnesBrowser/components/brave_account:features",
        "//BnesBrowser/components/email_aliases:features",
        "//chrome/browser/ui:chrome_pages",
      ]
    }

    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  }
}
