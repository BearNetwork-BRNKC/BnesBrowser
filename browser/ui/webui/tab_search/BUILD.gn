# Curerntly this target is desktop only because chromium's
# tab_search_page_handler is desktop only.
assert(!is_android)

source_set("browser_tests") {
  testonly = true

  sources = [ "tab_search_page_handler_browsertest.cc" ]

  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  deps = [
    "//base",
    "//BnesBrowser/browser/ai_chat",
    "//BnesBrowser/components/ai_chat/core/browser",
    "//BnesBrowser/components/ai_chat/core/browser:test_support",
    "//BnesBrowser/components/ai_chat/core/common/mojom",
    "//BnesBrowser/components/history_embeddings:test_support",
    "//BnesBrowser/components/local_ai/buildflags",
    "//BnesBrowser/components/local_ai/core",
    "//BnesBrowser/components/resources:strings_grit",
    "//chrome/browser/history",
    "//chrome/browser/ui",
    "//chrome/browser/ui/navigator",
    "//chrome/browser/ui/webui/tab_search",
    "//chrome/browser/ui/window_metadata",
    "//chrome/test",
    "//chrome/test:test_support",
    "//components/history/core/browser",
    "//components/history_embeddings/core",
    "//components/keyed_service/core",
    "//components/prefs",
    "//testing/gtest",
    "//ui/base",
  ]
}
