brave_browser_cosmetic_filters_sources = [
  "//BnesBrowser/browser/cosmetic_filters/cosmetic_filters_tab_helper.cc",
  "//BnesBrowser/browser/cosmetic_filters/cosmetic_filters_tab_helper.h",
]

brave_browser_cosmetic_filters_deps = [
  "//base",
  "//BnesBrowser/components/cosmetic_filters/common:mojom",
  "//chrome/browser/ui",
  "//chrome/browser/ui/color:color_headers",
  "//third_party/blink/public/common",
]

if (is_android) {
  brave_browser_cosmetic_filters_sources += [
    "//BnesBrowser/browser/android/cosmetic_filters/cosmetic_filters_utils.cc",
    "//BnesBrowser/browser/android/cosmetic_filters/cosmetic_filters_utils.h",
  ]

  brave_browser_cosmetic_filters_deps += [
    "//BnesBrowser/build/android:jni_headers",
    "//chrome/browser/android:tabs_public",
  ]
} else {
  brave_browser_cosmetic_filters_deps +=
      [ "//chrome/browser/ui/browser_window" ]
}
