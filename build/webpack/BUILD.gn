import("//BnesBrowser/build/node_action.gni")
import("//BnesBrowser/components/ai_chat/core/common/buildflags/buildflags.gni")
import("//BnesBrowser/components/brave_origin/buildflags/buildflags.gni")
import("//BnesBrowser/components/brave_rewards/core/buildflags/buildflags.gni")
import("//BnesBrowser/components/brave_wallet/common/buildflags/buildflags.gni")
import("//BnesBrowser/components/email_aliases/buildflags/buildflags.gni")

# Generate a JSON config file with build flags
generated_file("build_flags_json") {
  outputs = [ "$root_gen_dir/BnesBrowser/build_flags.json" ]

  contents = {
    enable_ai_chat = enable_ai_chat
    enable_ai_chat_tab_management_tool = enable_ai_chat_tab_management_tool
    enable_brave_rewards = enable_brave_rewards
    enable_brave_wallet = enable_brave_wallet
    enable_email_aliases = enable_email_aliases
    is_brave_origin_branded = is_brave_origin_branded
    is_official_build = is_official_build
    is_ios = is_ios
    is_android = is_android
    is_linux = is_linux
    is_mac = is_mac
    is_win = is_win
    is_desktop = is_linux || is_mac || is_win
    is_storybook = false
  }

  output_conversion = "json"
}

node_action("generate_tsconfig") {
  script = "//BnesBrowser/build/webpack/generate-ts-config.ts"

  deps = [
    ":build_flags_json",
    "//BnesBrowser/components/common:preprocess_package_json",

    # Ensure chrome://resources/js file and typescript definitions are
    # generated
    "//ui/webui/resources/js:build_ts",
  ]
  inputs = [
    "$root_gen_dir/BnesBrowser/components/common/package.json",
    "//BnesBrowser/pnpm-lock.yaml",
    "//BnesBrowser/tsconfig-webpack.json",
    "path-map.ts",
    "ts-config.ts",
  ]
  outputs = [ "$root_gen_dir/tsconfig-webpack.json" ]
  args = [
    "--root-gen-dir=" + rebase_path(root_gen_dir, root_build_dir),
    "--name=tsconfig-webpack.json",
    "--extends-from=" +
        rebase_path("//BnesBrowser/tsconfig-webpack.json", root_build_dir),
  ]
}
