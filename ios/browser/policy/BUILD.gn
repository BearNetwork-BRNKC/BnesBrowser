import("//BnesBrowser/components/brave_talk/buildflags/buildflags.gni")
import("//BnesBrowser/components/brave_vpn/common/buildflags/buildflags.gni")
import("//BnesBrowser/components/brave_wallet/common/buildflags/buildflags.gni")
import("//BnesBrowser/components/email_aliases/buildflags/buildflags.gni")

source_set("policy") {
  sources = [
    "brave_simple_policy_map_ios.h",
    "configuration_policy_handler_list_factory_impl.mm",
  ]
  deps = [
    "//BnesBrowser/components/ai_chat/core/common",
    "//BnesBrowser/components/brave_news/common",
    "//BnesBrowser/components/brave_rewards/core",
    "//BnesBrowser/components/brave_talk/buildflags",
    "//BnesBrowser/components/brave_vpn/common/buildflags",
    "//BnesBrowser/components/constants",
    "//BnesBrowser/components/email_aliases/buildflags",
    "//BnesBrowser/components/p3a",
    "//BnesBrowser/components/playlist/core/common",
    "//components/policy/core/browser",
    "//ios/chrome/browser/policy/model",
  ]
  if (enable_brave_vpn) {
    deps += [ "//BnesBrowser/components/brave_vpn/common" ]
  }
  if (enable_brave_wallet) {
    deps += [ "//BnesBrowser/components/brave_wallet/browser:pref_names" ]
  }
  if (enable_brave_talk) {
    deps += [ "//BnesBrowser/components/brave_talk" ]
  }
  if (enable_email_aliases) {
    deps += [
      "//BnesBrowser/components/email_aliases:pref_names",
      "//BnesBrowser/components/email_aliases:service",
    ]
  }
}
