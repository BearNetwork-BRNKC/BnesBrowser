import("//BnesBrowser/build/ios/mojom/mojom_wrappers.gni")
import("//build/config/ios/rules.gni")

config("external_config") {
  visibility = [ ":*" ]
  include_dirs = [ "$target_gen_dir" ]
}

source_set("ads") {
  configs += [ ":external_config" ]

  sources = [
    "ads_client_bridge.h",
    "ads_client_ios.h",
    "ads_client_ios.mm",
    "brave_ads.h",
    "brave_ads.mm",
  ]

  deps = [
    ":brave_ads_mojom_wrappers",
    "//base",
    "//BnesBrowser/components/brave_ads/core",
    "//BnesBrowser/components/brave_news/common",
    "//BnesBrowser/components/brave_rewards/core",
    "//BnesBrowser/components/l10n/common",
    "//BnesBrowser/components/ntp_background_images/browser",
    "//BnesBrowser/components/ntp_background_images/common",
    "//BnesBrowser/ios/browser/api/common",
    "//BnesBrowser/ios/browser/brave_ads",
    "//components/prefs",
    "//ios/chrome/browser/shared/model/application_context",
    "//ios/chrome/browser/shared/model/profile",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
  ]

  frameworks = [
    "Foundation.framework",
    "UIKit.framework",
    "Network.framework",
  ]
}

ios_objc_mojom_wrappers("brave_ads_mojom_wrappers") {
  mojom_target = "//BnesBrowser/components/brave_ads/core/mojom"
  sources = [ "//BnesBrowser/components/brave_ads/core/mojom/brave_ads.mojom" ]
  exclude_types = [
    "DBActionInfo",
    "DBBindColumnInfo",
    "DBTransactionResultInfo",
    "DBRowsUnion",
    "DBRowInfo",
    "DBTransactionInfo",
    "DBColumnValueUnion",
  ]

  # The module name is `BraveAds` now which matches the class we already have
  generate_namespace = false
}
